dcache0:
    size: 0x2400000

irom: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x60000

drom: Memory.MappedMemory @ sysbus 0x3FF00000
    size: 0x20000

system: Memory.MappedMemory @ sysbus 0x600C0000
    size: 0x1000

extmem: Miscellaneous.ESP32S3_EXTMEM @ sysbus 0x600C4000

rtc_cntl: Miscellaneous.ESP32_RTC_CNTL @ sysbus 0x60008000

timg0: Timers.ESP32_TIMG @ sysbus 0x6001F000

spi1: SPI.ESP32_SPIController @ sysbus 0x60002000
    generation: ESP32Generation.ESP32S3

spiflash: SPI.GenericSpiFlash @ spi1
    underlyingMemory: flash0
    manufacturerId: 0xC8
    memoryType: 0x40

// Zephyr's simple boot reads flash with esp_rom_flash_read(), which maps one 64 KiB flash page at a
// time into the 0x3DFF0000 cache window through MMU entry 511. Without an MMU model this entry copies the
// requested flash0 page into that window. Drop it once an ESP32 cache MMU model is upstreamed.
flash_read_mmu: Python.PythonPeripheral @ sysbus 0x600C57FC
    size: 0x4
    initable: false
    script: '''
if request.IsWrite and not request.Value & 0xC000:
    from Antmicro.Renode.Peripherals import IPeripheralExtensions
    bus = IPeripheralExtensions.GetMachine(self).SystemBus
    bus.WriteBytes(bus.ReadBytes((request.Value & 0x3FFF) << 16, 0x10000), 0x3DFF0000)
'''

sysbus:
    init:
        // GPIO46 low keeps the ROM's boot messages on, GPIO0 high skips the download bootloader.
        Tag <0x60004038 0x4> "GPIO_STRAP" 0x8
        // BBPLL_CAL_DONE, polled by the ROM after it starts the PLL calibration.
        Tag <0x6000e040 0x4> "I2C_MST_ANA_CONF0" 0x01000000

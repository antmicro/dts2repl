sysbus:
    init add:
        Tag <0x4500800C 0x4> "OSC32KCTRL_STATUS" 0x1
        Tag <0x4500200C 0x4> "SUPC_STATUS" 0x100

clock: Python.PythonPeripheral @ sysbus 0x44006000
    size: 0x4060
    initable: true
    script: '''
if request.IsInit:
    regs = {0x10: 0x01000101}
elif request.IsWrite:
    if request.Offset != 0x10:
        regs[request.Offset] = request.Value
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''
